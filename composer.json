{
    "name": "gcs-technologie/laravel-calendar",
    "description": "Laravel helper for FullCalendar.io",
    "license": "MIT",
    "type": "package",
    "authors": [
        {
            "name": "gcs-technologie",
            "email": "adminplateforme@gcs-technologie.com"
        }
    ],
    "require": {
        "php": ">=7.2.5",
        "illuminate/support": "^7.0|^8.0|^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "GCS\\LaravelCalendar\\": "src"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "GCS\\LaravelCalendar\\ServiceProvider"
            ],
            "aliases": {
                "Calendar": "GCS\\LaravelCalendar\\Facades\\Calendar"
            }
        }
    },
    "minimum-stability": "stable"
}
